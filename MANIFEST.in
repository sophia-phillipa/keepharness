include LICENSE README.md setup.sh start.sh install.sh requirements.txt
recursive-include docs *.md
recursive-include dossier *.md
recursive-include tests *.py *.cjs
recursive-include scripts *.sh *.py *.py

include profiles/local-cpu-profile.json profiles/qwen-vulkan-profile.json

recursive-include Adapters *.py *.md *.json

# Git ignore rules do not filter an sdist manifest.
prune .codex
prune local-ai
prune pytest-of-unknown
exclude AGENTS.md
