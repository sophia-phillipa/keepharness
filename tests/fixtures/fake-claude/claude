#!/usr/bin/env python3
"""Fake `claude` CLI for provider-state tests; mirrors Claude Code 2.1.292 (observed 2026-10-07).

Commands: `--version`, `plugin --help`, `plugin marketplace --help` and
`plugin enable|disable <id> [-s user|project|local] [--json]`.
A stream-json turn (`--input-format stream-json`) whose prompt contains `FAKE-EDITS` plays a
stream: Edit, MultiEdit, a failed Edit, Write and Bash tool calls, then a text answer. Any other
prompt, and any other command, exits 2.

Control files (the adapter strips the environment, so the fake reads files, not variables), both
inside the config directory ($CLAUDE_CONFIG_DIR, else ~/.claude):
  fake-claude-version   one line replaces the reported version (default 2.1.292)
  fake-claude-fail      its presence makes every plugin command fail like a settings write error;
                        any text in it replaces the failure reason
  fake-claude-help      how `plugin --help` answers: absent (no `marketplace` verb), fail (exit 1),
                        garbage (no command table), hang (never answers); no file means normal
Settings files: user -> <config dir>/settings.json, project -> <cwd>/.claude/settings.json,
local -> <cwd>/.claude/settings.local.json; written with a 2-space indent like the real CLI.
"""

import json
import os
import sys
import time
from pathlib import Path

DEFAULT_VERSION = "2.1.292"
SCOPES = ("user", "project", "local")
HANG_SECONDS = 60
# Commander layout, as `claude plugin --help` prints it.
PLUGIN_HELP_HEAD = """Usage: claude plugin [options] [command]

Manage Claude Code plugins

Options:
  -h, --help                       display help for command

Commands:
"""
PLUGIN_COMMANDS = (
    "  install|i [options] <plugin>     Install a plugin\n",
    "  marketplace                      Manage plugin marketplaces\n",
    "  uninstall|rm [options] <plugin>  Uninstall a plugin\n",
)
MARKETPLACE_HELP = """Usage: claude plugin marketplace [options] [command]

Manage plugin marketplaces

Commands:
  add <source>      Add a marketplace
  list              List configured marketplaces
  remove|rm <name>  Remove a configured marketplace
"""


def config_dir() -> Path:
    configured = os.environ.get("CLAUDE_CONFIG_DIR")
    return Path(configured) if configured else Path.home() / ".claude"


def settings_path(scope: str) -> Path:
    if scope == "user":
        return config_dir() / "settings.json"
    name = "settings.json" if scope == "project" else "settings.local.json"
    return Path.cwd() / ".claude" / name


def parse(arguments: list[str]) -> tuple[str, str, str, bool]:
    scope, as_json, positional = "user", False, []
    index = 0
    while index < len(arguments):
        argument = arguments[index]
        if argument in ("-s", "--scope"):
            index += 1
            scope = arguments[index] if index < len(arguments) else ""
        elif argument == "--json":
            as_json = True
        else:
            positional.append(argument)
        index += 1
    if len(positional) != 2:
        sys.exit("error: expected `plugin enable|disable <plugin>`")
    return positional[0], positional[1], scope, as_json


def finish(outcome: dict, as_json: bool, code: int) -> None:
    print(json.dumps(outcome) if as_json else outcome["message"])
    sys.exit(code)


def toggle(command: str, plugin: str, scope: str, as_json: bool) -> None:
    if scope not in SCOPES:
        print(f'Invalid scope "{scope}". Valid scopes: user, project, local', file=sys.stderr)
        sys.exit(1)
    base = {"command": command, "plugin": plugin, "scope": scope}
    path = settings_path(scope)
    failure = None
    if (config_dir() / "fake-claude-fail").exists():
        failure = (config_dir() / "fake-claude-fail").read_text().strip() or (
            f"Invalid JSON syntax in settings file at {path}"
        )
    document = {}
    if failure is None and path.exists():
        try:
            document = json.loads(path.read_text())
        except ValueError:
            failure = f"Invalid JSON syntax in settings file at {path}"
    if failure is not None:
        message = f"Failed to {command} plugin: {failure}"
        base |= {"outcome": "failed", "message": message, "failureCode": "settings_write_failed"}
        print(message, file=sys.stderr)
        finish(base, as_json, 1)
    document.setdefault("enabledPlugins", {})[plugin] = command == "enable"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(document, indent=2) + "\n")
    name = plugin.split("@")[0]
    verb = "enabled" if command == "enable" else "disabled"
    message = f"Successfully {verb} plugin: {name} (scope: {scope})"
    finish(base | {"outcome": "ok", "pluginId": plugin, "message": message}, as_json, 0)


SESSION = "fake-claude-session"
ANSWER = "Done: the edits are in place."
# (tool_use id, tool name, input, is_error); the input is what the assistant message carries.
EDIT_CALLS = (
    ("tool-edit", "Edit", {"old_string": "a = 1", "new_string": "a = 2"}, False),
    (
        "tool-multi",
        "MultiEdit",
        {
            "edits": [
                {"old_string": "def f():", "new_string": "def g():"},
                {"old_string": "return 1", "new_string": "return 2"},
            ]
        },
        False,
    ),
    ("tool-failed", "Edit", {"old_string": "b = 1", "new_string": "b = 2"}, True),
    ("tool-write", "Write", {"content": "# Todo\n- ship it\n"}, False),
    ("tool-bash", "Bash", {"command": "sed -i 's/a = 1/a = 2/' src/app.py"}, False),
)
EDIT_PATHS = {
    "tool-edit": "src/app.py",
    "tool-multi": "src/util.py",
    "tool-failed": "src/app.py",
    "tool-write": "notes/todo.md",
}


def emit(item: dict) -> None:
    print(json.dumps(item), flush=True)


def stream_event(event: dict) -> None:
    emit({"type": "stream_event", "event": event, "session_id": SESSION})


def message_events(message_id: str, blocks: list[dict], stop_reason: str, output: int) -> None:
    """One streamed assistant message: its deltas, then the complete assistant message.

    A tool_use block starts with an empty input, as in a real stream; its input arrives as
    input_json_delta fragments and in full only on the assistant message.
    """
    usage = {"input_tokens": 12, "cache_read_input_tokens": 0, "output_tokens": 0}
    stream_event({"type": "message_start", "message": {"id": message_id, "usage": usage}})
    for index, block in enumerate(blocks):
        if block["type"] == "tool_use":
            text = json.dumps(block["input"])
            half = len(text) // 2
            stream_event(
                {
                    "type": "content_block_start",
                    "index": index,
                    "content_block": {**block, "input": {}},
                }
            )
            for part in (text[:half], text[half:]):
                stream_event(
                    {
                        "type": "content_block_delta",
                        "index": index,
                        "delta": {"type": "input_json_delta", "partial_json": part},
                    }
                )
        else:
            stream_event(
                {
                    "type": "content_block_start",
                    "index": index,
                    "content_block": {**block, "text": ""},
                }
            )
            stream_event(
                {
                    "type": "content_block_delta",
                    "index": index,
                    "delta": {"type": "text_delta", "text": block["text"]},
                }
            )
        stream_event({"type": "content_block_stop", "index": index})
    stream_event(
        {
            "type": "message_delta",
            "delta": {"stop_reason": stop_reason},
            "usage": {"output_tokens": output},
        }
    )
    stream_event({"type": "message_stop"})
    emit(
        {
            "type": "assistant",
            "session_id": SESSION,
            "message": {"id": message_id, "role": "assistant", "content": blocks},
        }
    )


def play_turn() -> None:
    """Plays the FAKE-EDITS stream: one tool call per message, each with its tool_result, then the answer."""
    emit({"type": "system", "subtype": "init", "session_id": SESSION})
    root = os.getcwd()
    for number, (tool_id, name, args, failed) in enumerate(EDIT_CALLS):
        if name == "Bash":
            tool_input = args
        else:
            path = EDIT_PATHS[tool_id]
            tool_input = {"file_path": str(Path(root) / path), **args}
        block = {"type": "tool_use", "id": tool_id, "name": name, "input": tool_input}
        message_events(f"msg-tool-{number}", [block], "tool_use", 30)
        content = "String to replace not found in file." if failed else "ok"
        result = {
            "type": "tool_result",
            "tool_use_id": tool_id,
            "content": content,
            "is_error": failed,
        }
        emit(
            {
                "type": "user",
                "session_id": SESSION,
                "message": {"role": "user", "content": [result]},
            }
        )
    text = {"type": "text", "text": ANSWER}
    message_events("msg-answer", [text], "end_turn", 20)
    usage = {
        "input_tokens": 12,
        "cache_read_input_tokens": 0,
        "cache_creation_input_tokens": 0,
        "output_tokens": 20,
    }
    emit(
        {
            "type": "result",
            "subtype": "success",
            "is_error": False,
            "result": ANSWER,
            "session_id": SESSION,
            "usage": usage,
        }
    )


def prompt_of(line: str) -> str:
    """The text of the first stream-json user message; empty when the line is not one."""
    try:
        message = json.loads(line)
    except ValueError:
        return ""
    content = message.get("message", {}).get("content", []) if isinstance(message, dict) else []
    return "".join(b.get("text", "") for b in content if isinstance(b, dict))


def plugin_help() -> None:
    """`plugin --help`; the fake-claude-help control file picks the variant."""
    control = config_dir() / "fake-claude-help"
    mode = control.read_text().strip() if control.exists() else "normal"
    if mode == "fail":
        print("error: plugin help is unavailable", file=sys.stderr)
        sys.exit(1)
    if mode == "garbage":
        print("Commands:\n  !!! ***  not a command table")
    elif mode == "hang":
        time.sleep(HANG_SECONDS)
    else:
        lines = [line for line in PLUGIN_COMMANDS if mode != "absent" or "marketplace" not in line]
        print(PLUGIN_HELP_HEAD + "".join(lines), end="")


def main(arguments: list[str]) -> None:
    if arguments == ["--version"]:
        override = config_dir() / "fake-claude-version"
        version = override.read_text().strip() if override.exists() else DEFAULT_VERSION
        print(f"{version} (Claude Code)")
    elif arguments == ["plugin", "--help"]:
        plugin_help()
    elif arguments == ["plugin", "marketplace", "--help"]:
        print(MARKETPLACE_HELP, end="")
    elif arguments[:1] == ["plugin"] and arguments[1:2] in (["enable"], ["disable"]):
        command, plugin, scope, as_json = parse(arguments[1:])
        toggle(command, plugin, scope, as_json)
    elif "--input-format" in arguments and "FAKE-EDITS" in prompt_of(sys.stdin.readline()):
        play_turn()
    else:
        print("error: the fake claude CLI does not implement this command", file=sys.stderr)
        sys.exit(2)


main(sys.argv[1:])
