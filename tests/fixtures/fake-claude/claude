#!/usr/bin/env python3
"""Fake `claude` CLI for provider-state tests; mirrors Claude Code 2.1.292 (observed 2026-10-07).

Commands: `--version` and `plugin enable|disable <id> [-s user|project|local] [--json]`.
Nothing else is faked; any other command exits 2.

Control files (the adapter strips the environment, so the fake reads files, not variables), both
inside the config directory ($CLAUDE_CONFIG_DIR, else ~/.claude):
  fake-claude-version   one line replaces the reported version (default 2.1.292)
  fake-claude-fail      its presence makes every plugin command fail like a settings write error
Settings files: user -> <config dir>/settings.json, project -> <cwd>/.claude/settings.json,
local -> <cwd>/.claude/settings.local.json; written with a 2-space indent like the real CLI.
"""

import json
import os
import sys
from pathlib import Path

DEFAULT_VERSION = "2.1.292"
SCOPES = ("user", "project", "local")


def config_dir() -> Path:
    configured = os.environ.get("CLAUDE_CONFIG_DIR")
    return Path(configured) if configured else Path.home() / ".claude"


def settings_path(scope: str) -> Path:
    if scope == "user":
        return config_dir() / "settings.json"
    name = "settings.json" if scope == "project" else "settings.local.json"
    return Path.cwd() / ".claude" / name


def parse(arguments: list[str]) -> tuple[str, str, str, bool]:
    scope, as_json, positional = "user", False, []
    index = 0
    while index < len(arguments):
        argument = arguments[index]
        if argument in ("-s", "--scope"):
            index += 1
            scope = arguments[index] if index < len(arguments) else ""
        elif argument == "--json":
            as_json = True
        else:
            positional.append(argument)
        index += 1
    if len(positional) != 2:
        sys.exit("error: expected `plugin enable|disable <plugin>`")
    return positional[0], positional[1], scope, as_json


def finish(outcome: dict, as_json: bool, code: int) -> None:
    print(json.dumps(outcome) if as_json else outcome["message"])
    sys.exit(code)


def toggle(command: str, plugin: str, scope: str, as_json: bool) -> None:
    if scope not in SCOPES:
        print(f'Invalid scope "{scope}". Valid scopes: user, project, local', file=sys.stderr)
        sys.exit(1)
    base = {"command": command, "plugin": plugin, "scope": scope}
    path = settings_path(scope)
    failure = None
    if (config_dir() / "fake-claude-fail").exists():
        failure = f"Invalid JSON syntax in settings file at {path}"
    document = {}
    if failure is None and path.exists():
        try:
            document = json.loads(path.read_text())
        except ValueError:
            failure = f"Invalid JSON syntax in settings file at {path}"
    if failure is not None:
        message = f"Failed to {command} plugin: {failure}"
        base |= {"outcome": "failed", "message": message, "failureCode": "settings_write_failed"}
        print(message, file=sys.stderr)
        finish(base, as_json, 1)
    document.setdefault("enabledPlugins", {})[plugin] = command == "enable"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(document, indent=2) + "\n")
    name = plugin.split("@")[0]
    verb = "enabled" if command == "enable" else "disabled"
    message = f"Successfully {verb} plugin: {name} (scope: {scope})"
    finish(base | {"outcome": "ok", "pluginId": plugin, "message": message}, as_json, 0)


def main(arguments: list[str]) -> None:
    if arguments == ["--version"]:
        override = config_dir() / "fake-claude-version"
        version = override.read_text().strip() if override.exists() else DEFAULT_VERSION
        print(f"{version} (Claude Code)")
    elif arguments[:1] == ["plugin"] and arguments[1:2] in (["enable"], ["disable"]):
        command, plugin, scope, as_json = parse(arguments[1:])
        toggle(command, plugin, scope, as_json)
    else:
        print("error: the fake claude CLI does not implement this command", file=sys.stderr)
        sys.exit(2)


main(sys.argv[1:])
